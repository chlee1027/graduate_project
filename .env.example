# Database Configuration
DATABASE_URL=postgresql://postgres:1234@localhost:5432/fitness_ai

# Gemini API
# app/core/config.py 가 이 이름으로 읽는다. 비어 있으면 AI 코치와 운동 가이드가
# 500 을 돌려준다(추천 자체는 이 키 없이도 동작한다).
GEMINI_API_KEY=

# Backend Configuration
# 추천 알고리즘 상수는 app/core/config.py 의 기본값을 쓰며, 필요하면 여기서 덮어쓴다.
# EPSILON=0.2
