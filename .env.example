# Database Configuration
DATABASE_URL=postgresql://postgres:1234@localhost:5432/fitness_ai

# Claude API (AI 코치·운동 가이드)
# app/core/config.py 가 이 이름으로 읽는다. 비어 있으면 AI 코치와 운동 가이드가
# 503 을 돌려준다(추천 자체는 이 키 없이도 동작한다).
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=low

# AI 코치 호출 제한 (공개 데모용, 0 이면 제한 없음). 배포에서는 RATE_LIMIT_SALT 를 임의 값으로 둔다.
# CHATBOT_PER_IP_PER_HOUR=10
# CHATBOT_PER_DAY=200
# RATE_LIMIT_SALT=

# Backend Configuration
# 추천 알고리즘 상수는 app/core/config.py 의 기본값을 쓰며, 필요하면 여기서 덮어쓴다.
# EPSILON=0.2
